# Postgres connection string (Supabase: Project Settings -> Database -> Connection pooling, transaction mode, port 6543)
DATABASE_URL=
# Supabase CA certificate (Project Settings -> Database -> SSL Configuration -> Download certificate), full PEM text
DATABASE_CA_CERT=
# Random string, 32+ chars: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# Public site URL, e.g. https://your-app.vercel.app
BETTER_AUTH_URL=
# Google OAuth (optional until you create them)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# SMTP for email verification. Gmail: host=smtp.gmail.com port=587 user=<you>@gmail.com
# pass=<App Password from myaccount.google.com/apppasswords>. Leave empty in dev to print the link to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Опитування <no-reply@example.com>
